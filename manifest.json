{
  "manifest_version": 3,
  "name": "FC 26 SBC Automation",
  "version": "1.0.0",
  "description": "Automates repeated SBC completion loops in FC 26 Ultimate Team Web App.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.ea.com/*",
    "https://*.ea.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FC 26 SBC Automation"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/*",
        "https://*.ea.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
