{
  "manifest_version": 3,
  "name": "FC 26 SBC Automator",
  "version": "1.1.0",
  "description": "Automates deterministic SBC completion loops in FC 26 Ultimate Team Web App with strict safety checks.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.ea.com/*",
    "https://*.ea.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FC 26 SBC Automator",
    "default_popup": "popup.html"
  }
}
